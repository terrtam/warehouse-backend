# Copy this file to .env locally and fill real values.
# Do not commit .env with real credentials.

# Database
WMS_DB_URL=jdbc:postgresql://localhost:5432/warehouse
WMS_DB_USERNAME=postgres
WMS_DB_PASSWORD=your_database_password

# JWT
WMS_JWT_SECRET=replace_with_at_least_32_ascii_characters
WMS_JWT_EXPIRATION_MS=3600000

# Enable real outbound email (default is false in application.yml)
WMS_COMMUNICATION_EMAIL_ENABLED=true

# Gmail SMTP
WMS_SMTP_HOST=smtp.gmail.com
WMS_SMTP_PORT=587
WMS_SMTP_USERNAME=yourgmail@gmail.com
WMS_SMTP_PASSWORD=your_google_app_password
WMS_SMTP_AUTH=true
WMS_SMTP_STARTTLS_ENABLE=true

# Sender address (must be allowed by your SMTP account/provider)
WMS_EMAIL_FROM=yourgmail@gmail.com
